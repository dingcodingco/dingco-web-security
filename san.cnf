# openssl 자체서명 인증서용 설정 파일
# CSR(인증요청서) 생성 시 입력값을 미리 채워두고,
# 브라우저/curl 이 요구하는 SAN(Subject Alternative Name) 을 부여한다.
[req]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
req_extensions     = req_ext

[dn]
C  = KR
ST = Seoul
L  = Seoul
O  = dingco
OU = dingco
CN = localhost

[req_ext]
subjectAltName = @alt_names

# 인증서에 그대로 복사할 확장 (자체서명 단계에서 -extfile 로 재사용)
[v3_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = localhost
IP.1  = 127.0.0.1
